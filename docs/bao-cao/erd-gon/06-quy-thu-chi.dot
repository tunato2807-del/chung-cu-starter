digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.48", ranksep="0.68", splines=polyline, overlap=false, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Quỹ, thu chi và chứng từ — 4 bảng"];
