digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.48", ranksep="0.68", splines=polyline, overlap=false, fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Nhà ở, cư trú, tài khoản và xe — 7 bảng"];
node [shape=plain, fontname="DejaVu Sans", fontsize=14];
edge [constraint=false, dir=none, color="#58716c", fontname="DejaVu Sans", fontsize=11, labeldistance=1.7, labelangle=25];
"nguoi_dung" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c0d2cc"><TR><TD BGCOLOR="#145f59" ALIGN="LEFT"><FONT COLOR="white"><B>nguoi_dung</B></FONT></TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">PK · ma_nguoi_dung</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">ho_va_ten</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">vai_tro</TD></TR></TABLE>>];
