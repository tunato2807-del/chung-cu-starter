"can_ho" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c0d2cc"><TR><TD BGCOLOR="#145f59" ALIGN="LEFT"><FONT COLOR="white"><B>can_ho</B></FONT></TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">PK · ma_can_ho</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">so_can_ho</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">dien_tich_m2</TD></TR></TABLE>>];
"cu_dan" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#c0d2cc"><TR><TD BGCOLOR="#145f59" ALIGN="LEFT"><FONT COLOR="white"><B>cu_dan</B></FONT></TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">PK · ma_cu_dan</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">ho_va_ten</TD></TR><TR><TD BGCOLOR="#f5f9f7" ALIGN="LEFT">so_dien_thoai</TD></TR></TABLE>>];
