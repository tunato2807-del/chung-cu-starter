digraph G { graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.35", ranksep="0.45", dpi=180, fontname="Liberation Serif", fontsize=15, splines=polyline]; node [fontname="Liberation Serif", fontsize=15, shape=box, style="rounded", margin="0.13,0.09", color="#222222"]; edge [fontname="Liberation Serif", fontsize=12, color="#333333", arrowsize=0.65];
k [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>khoi_toa_nha</B></TD></TR><TR><TD ALIGN="LEFT">PK khoi</TD></TR></TABLE>>];
t [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>tang_toa_nha</B></TD></TR><TR><TD ALIGN="LEFT">PK (khoi, tang)</TD></TR><TR><TD ALIGN="LEFT">FK khoi</TD></TR></TABLE>>];
h [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>can_ho</B></TD></TR><TR><TD ALIGN="LEFT">PK ma_can_ho</TD></TR><TR><TD ALIGN="LEFT">FK (khoi, tang)</TD></TR><TR><TD ALIGN="LEFT">so_can_ho, dien_tich_m2</TD></TR></TABLE>>];
c [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>cu_dan</B></TD></TR><TR><TD ALIGN="LEFT">PK ma_cu_dan</TD></TR><TR><TD ALIGN="LEFT">ho_va_ten, so_dien_thoai</TD></TR></TABLE>>];
r [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>lich_su_cu_tru</B></TD></TR><TR><TD ALIGN="LEFT">PK ma_lich_su_cu_tru</TD></TR><TR><TD ALIGN="LEFT">FK ma_cu_dan, ma_can_ho</TD></TR><TR><TD ALIGN="LEFT">tu_ngay, den_ngay, quan_he</TD></TR></TABLE>>];
v [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#eeeeee"><B>phuong_tien</B></TD></TR><TR><TD ALIGN="LEFT">PK ma_phuong_tien</TD></TR><TR><TD ALIGN="LEFT">FK cư dân / đợt ở / căn</TD></TR><TR><TD ALIGN="LEFT">loai_xe, bien_so</TD></TR></TABLE>>];
k -> t [dir=both, arrowtail=none, arrowhead=none, label="1 : N"];
t -> h [dir=both, arrowtail=none, arrowhead=none, label="1 : N"];
h -> r [dir=both, arrowtail=none, arrowhead=none, label="1 : N"];
c -> r [dir=both, arrowtail=none, arrowhead=none, label="1 : N"];
r -> v [dir=both, arrowtail=none, arrowhead=none, label="1 : N; gắn đợt"];
h -> v [dir=both, arrowtail=none, arrowhead=none, label="1 : N; căn chịu phí"];
}